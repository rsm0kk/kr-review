, "year": 2026, "kind": "FY", "label": "2026 연간 (YTD)", "from": "2026-01-01", "to": "2026-12-31", "startRef": "20251230", "endDate": "20260930", "ongoing": true, "startRefDate": "20251230"}], "covid": [{"id": "C1", "kind": "COVID", "label": "코로나 급락 (01/22 고점→03/19 저점)", "year": 2020, "startRef": "20200122", "endDate": "20200319", "ongoing": false, "from": null, "to": null, "startRefDate": "20200122"}, {"id": "C2", "kind": "COVID", "label": "저점 반등 1차 (03/19→6/30)", "year": 2020, "startRef": "20200319", "endDate": "20200630", "ongoing": false, "from": null, "to": null, "startRefDate": "20200319"}, {"id": "C3", "kind": "COVID", "label": "저점 이후 연말까지 (03/19→12/30)", "year": 2020, "startRef": "20200319", "endDate": "20201230", "ongoing": false, "from": null, "to": null, "startRefDate": "20200319"}], "rules": {"returnFormula": "기간 수익률 = (기간 종료 수정주가 / 기간 시작 직전 거래일 수정주가 − 1) × 100", "adjust": "일간 수익률 = 종가 ÷ (종가 − 거래소 기준가 대비). 기준가에 액면분할·병합·무상증자·주식배당·권리락·감자가 반영돼 있어 이를 누적(chain-link)한 것이 수정주가 지수. 전일 종가 ÷ 기준가가 2~50 또는 1/2~1/50 의 정수비와 1% 안으로 맞으면(액면분할·병합) 호가단위 반올림을 없애려 정확한 정수비로 보정. 현금배당은 미반영(가격수익률).", "start2020": "공공데이터 API 는 2020-01-02 부터 제공. 2019-12-30 종가는 2020-01-02 의 기준가(종가 − 대비)로 복원.", "universe": "코스피·코스닥 보통주. 우선주(코드 끝자리 ≠ 0 또는 이름이 ~우·~우B), 스팩, 리츠·인프라펀드·선박펀드, 코넥스, ETF·ETN 제외. 해외 기업(HK·KYG 등 ISIN) 은 포함하고 표시.", "eligibility": "기간 시작 직전 거래일에 상장돼 있던 종목만 정규 순위. 기간 중 신규 상장은 별도 탭. 기간 중 거래가 끝난 종목(상장폐지·합병)은 −100% 로 처리하지 않고 제외 목록에 마지막 거래일·그때까지 수익률을 공개.", "tie": "수익률 동률이면 기간 시작 시가총액이 큰 종목 우선, 그다음 종목코드 오름차순.", "investable": "투자 가능 필터: 기간 시작 직전 거래일 시가총액 1,000억 원 이상 + 직전 20거래일 평균 거래대금 10억 원 이상 (2020 상반기는 2019년 거래대금 자료가 없어 시가총액만 적용).", "market": "시장 구분은 기간 시작 시점 기준. 기간 중 이전상장은 표시.", "halt": "기간 말 기준 마지막 체결일이 20거래일 이상 전이면 거래정지 추정 경고.", "break": "기준가가 전일 종가와 다른 날 중 상장주식수 변화(±60거래일)로 설명되면 분할·병합·무상증자·감자로 보고 수정, 비율 1~1.6 이면 권리락·주식배당락으로 보고 수정, 그 밖(인적분할·합병 재상장, 장기정지 후 기준가 재평가 등)은 연속성 단절로 보고 그 날짜를 걸친 기간은 정규 순위에서 빼고 제외 목록에 공개.", "fwd": "사후 1·3·6·12개월 수익률은 기간 종료일에서 달력 개월 수만큼 뒤의 마지막 거래일. 기준일을 넘으면 미관찰. 순위 선정 뒤 계산한 설명용 사후 분석이며 예측 성과가 아님.", "source": "시세: 금융위원회 주식시세정보(공공데이터포털, KRX 제공). 지수: 금융위원회 지수시세정보 (단, 20260930 은 금융위 API 미게시로 네이버 지수 일봉 — 직전 거래일 값 일치 확인)."}}